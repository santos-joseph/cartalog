# ================================================
# CARTALOG API — Environment Variables
# ================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# -------- DATABASE --------
DATABASE_URL="postgresql://cartalog:cartalog_secret@localhost:5432/cartalog_dev"

# -------- JWT --------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-random-64-char-string-in-production-never-use-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-random-64-char-string-different-from-above"
JWT_REFRESH_EXPIRES_IN="7d"

# -------- APP --------
PORT=3333
NODE_ENV="development"
API_URL="http://localhost:3333"

# -------- CORS / DOMÍNIO --------
FRONTEND_URL="http://localhost:3000"
# Domínio base para subdomínios dos tenants (ex: cartalog.com → carstore.cartalog.com)
BASE_DOMAIN="cartalog.com"
# Ative somente se a API estiver atrás de um proxy reverso confiável.
TRUST_PROXY=false

# -------- UPLOADS --------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# -------- PEDIDOS DE DEMONSTRAÇÃO --------
# Use uma senha de app do Gmail, nunca a senha normal da conta.
SALES_INBOX_EMAIL="sejacartalog@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="sejacartalog@gmail.com"
SMTP_PASS=""
