// ============================================================
// CARTALOG — PRISMA SCHEMA
// Matching original SQL specification exactly
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar
  slug           String   @unique @db.VarChar
  logoUrl        String?  @map("logo_url") @db.Text
  primaryColor   String?  @map("primary_color") @db.VarChar
  secondaryColor String?  @map("secondary_color") @db.VarChar
  description    String?  @db.Text
  phone          String?  @db.VarChar
  whatsapp       String?  @db.VarChar
  email          String?  @db.VarChar
  createdAt      DateTime @default(now()) @map("created_at")

  users            User[]
  siteSettings     SiteSettings?
  seoSettings      SeoSettings?
  companyLocations CompanyLocation[]
  banners          Banner[]
  pages            Page[]
  categories       Category[]
  vehicles         Vehicle[]
  leads            Lead[]
  leadStatuses     LeadStatus[]
  leadTags         LeadTag[]
  featuredVehicles FeaturedVehicle[]
  searches         Search[]

  @@map("companies")
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String   @db.VarChar
  email        String   @db.VarChar
  passwordHash String   @map("password_hash") @db.Text
  role         String   @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at")

  company          Company           @relation(fields: [companyId], references: [id])
  leadInteractions LeadInteraction[]
  leadFollowups    LeadFollowup[]
  assignedLeads    Lead[]            @relation("AssignedLeads")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

// ============================================================
// SITE SETTINGS
// ============================================================

model SiteSettings {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String  @unique @map("company_id") @db.Uuid
  theme              String? @db.VarChar
  showPrices         Boolean @default(true) @map("show_prices")
  showWhatsappButton Boolean @default(true) @map("show_whatsapp_button")

  company Company @relation(fields: [companyId], references: [id])

  @@map("site_settings")
}

// ============================================================
// SEO SETTINGS
// ============================================================

model SeoSettings {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String  @unique @map("company_id") @db.Uuid
  metaTitle       String? @map("meta_title") @db.VarChar
  metaDescription String? @map("meta_description") @db.Text
  metaKeywords    String? @map("meta_keywords") @db.Text

  company Company @relation(fields: [companyId], references: [id])

  @@map("seo_settings")
}

// ============================================================
// COMPANY LOCATIONS
// ============================================================

model CompanyLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  address   String?  @db.VarChar
  city      String?  @db.VarChar
  state     String?  @db.VarChar
  zipCode   String?  @map("zip_code") @db.VarChar
  latitude  Decimal? @db.Decimal
  longitude Decimal? @db.Decimal

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_locations")
}

// ============================================================
// BANNERS
// ============================================================

model Banner {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  title      String  @db.VarChar
  subtitle   String? @db.VarChar
  imageUrl   String  @map("image_url") @db.Text
  buttonText String? @map("button_text") @db.VarChar
  buttonLink String? @map("button_link") @db.VarChar
  position   Int?
  isActive   Boolean @default(true) @map("is_active")

  company Company @relation(fields: [companyId], references: [id])

  @@map("banners")
}

// ============================================================
// PAGES
// ============================================================

model Page {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  title       String  @db.VarChar
  slug        String  @db.VarChar
  content     String  @db.Text
  isPublished Boolean @default(false) @map("is_published")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, slug])
  @@map("pages")
}

// ============================================================
// CATEGORIES (per company)
// ============================================================

model Category {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String @db.VarChar
  slug      String @db.VarChar

  company  Company   @relation(fields: [companyId], references: [id])
  vehicles Vehicle[]

  @@unique([companyId, slug])
  @@map("categories")
}

// ============================================================
// BRANDS & MODELS
// ============================================================

model Brand {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar

  models Model[]

  @@map("brands")
}

model Model {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId String @map("brand_id") @db.Uuid
  name    String @db.VarChar

  brand    Brand     @relation(fields: [brandId], references: [id])
  vehicles Vehicle[]

  @@unique([brandId, name])
  @@map("models")
}

// ============================================================
// FUELS & TRANSMISSIONS (lookup tables)
// ============================================================

model Fuel {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar

  vehicles Vehicle[]

  @@map("fuels")
}

model Transmission {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar

  vehicles Vehicle[]

  @@map("transmissions")
}

// ============================================================
// VEHICLES
// ============================================================

model Vehicle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  modelId        String   @map("model_id") @db.Uuid
  fuelId         String?  @map("fuel_id") @db.Uuid
  transmissionId String?  @map("transmission_id") @db.Uuid
  slug           String   @db.VarChar
  year           Int
  mileage        Int      @default(0)
  price          Decimal  @db.Decimal
  color          String?  @db.VarChar
  description    String?  @db.Text
  status         String   @default("available") @db.VarChar
  createdAt      DateTime @default(now()) @map("created_at")

  company       Company               @relation(fields: [companyId], references: [id])
  category      Category?             @relation(fields: [categoryId], references: [id])
  model         Model                 @relation(fields: [modelId], references: [id])
  fuel          Fuel?                 @relation(fields: [fuelId], references: [id])
  transmission  Transmission?         @relation(fields: [transmissionId], references: [id])
  images        VehicleImage[]
  features      VehicleFeature[]
  leads         Lead[]
  views         VehicleView[]
  featured      FeaturedVehicle[]
  leadInterests LeadVehicleInterest[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([modelId])
  @@map("vehicles")
}

// ============================================================
// VEHICLE IMAGES
// ============================================================

model VehicleImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId String  @map("vehicle_id") @db.Uuid
  imageUrl  String  @map("image_url") @db.Text
  isCover   Boolean @default(false) @map("is_cover")
  position  Int?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_images")
}

// ============================================================
// FEATURES
// ============================================================

model Feature {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar

  vehicles VehicleFeature[]

  @@map("features")
}

model VehicleFeature {
  vehicleId String @map("vehicle_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@id([vehicleId, featureId])
  @@map("vehicle_features")
}

// ============================================================
// FEATURED VEHICLES
// ============================================================

model FeaturedVehicle {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid
  position  Int?

  company Company @relation(fields: [companyId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("featured_vehicles")
}

// ============================================================
// VEHICLE VIEWS
// ============================================================

model VehicleView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_views")
}

// ============================================================
// SEARCHES
// ============================================================

model Search {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  query      String   @db.VarChar
  searchedAt DateTime @default(now()) @map("searched_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("searches")
}

// ============================================================
// LEAD STATUS (customizable per company)
// ============================================================

model LeadStatus {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String @db.VarChar
  position  Int?

  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@map("lead_status")
}

// ============================================================
// LEADS
// ============================================================

model Lead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  vehicleId      String?  @map("vehicle_id") @db.Uuid
  assignedUserId String?  @map("assigned_user_id") @db.Uuid
  statusId       String?  @map("status_id") @db.Uuid
  name           String   @db.VarChar
  phone          String?  @db.VarChar
  email          String?  @db.VarChar
  message        String?  @db.Text
  source         String?  @db.VarChar
  createdAt      DateTime @default(now()) @map("created_at")

  company          Company               @relation(fields: [companyId], references: [id])
  vehicle          Vehicle?              @relation(fields: [vehicleId], references: [id])
  assignedUser     User?                 @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  status           LeadStatus?           @relation(fields: [statusId], references: [id])
  interactions     LeadInteraction[]
  followups        LeadFollowup[]
  tags             LeadTagRelation[]
  vehicleInterests LeadVehicleInterest[]

  @@index([companyId])
  @@map("leads")
}

// ============================================================
// LEAD INTERACTIONS
// ============================================================

model LeadInteraction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@map("lead_interactions")
}

// ============================================================
// LEAD FOLLOWUPS
// ============================================================

model LeadFollowup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  scheduledAt DateTime @map("scheduled_at")
  note        String?  @db.Text
  completed   Boolean  @default(false)

  lead Lead  @relation(fields: [leadId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@map("lead_followups")
}

// ============================================================
// LEAD TAGS
// ============================================================

model LeadTag {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String @db.VarChar

  company  Company           @relation(fields: [companyId], references: [id])
  leadRels LeadTagRelation[]

  @@map("lead_tags")
}

model LeadTagRelation {
  leadId String @map("lead_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  lead Lead    @relation(fields: [leadId], references: [id])
  tag  LeadTag @relation(fields: [tagId], references: [id])

  @@id([leadId, tagId])
  @@index([tagId])
  @@index([leadId])
  @@map("lead_tag_relations")
}

// ============================================================
// LEAD VEHICLE INTEREST
// ============================================================

model LeadVehicleInterest {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String @map("lead_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  lead    Lead    @relation(fields: [leadId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("lead_vehicle_interest")
}
